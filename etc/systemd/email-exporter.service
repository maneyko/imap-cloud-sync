[Unit]
Description=Sync IMAP mailboxes to S3 (email-exporter)
After=network-online.target

[Service]
Type=oneshot
User=email-exporter
EnvironmentFile=/etc/email-exporter/environment
ExecStart=/opt/email-exporter/main.py
# main.py exits 128+signum after checkpointing, so a `systemctl stop` is not a failure.
SuccessExitStatus=130 143
